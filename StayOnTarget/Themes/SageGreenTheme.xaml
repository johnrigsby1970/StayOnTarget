<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Backgrounds & Surface Colors -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F5F3" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#E5ECE7" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#D8E2DC" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#C1D1C7" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#CCDCD2" />
    <SolidColorBrush x:Key="ModalBackgroundBrush" Color="#E5ECE7" />

    <!-- Text & Typography -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F2923" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A6B60" />
    <SolidColorBrush x:Key="SpecialHeadingBrush" Color="#3B6E52" />

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#C5D3C9" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#D3DFD7" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#8F9E94" />

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#D8E2DC" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#F2F5F3" />
    <SolidColorBrush x:Key="DataGridAltRowBackgroundBrush" Color="#E5ECE7" />
    <SolidColorBrush x:Key="DataGridRowForegroundBrush" Color="#1F2923" />

    <!-- ScrollBar & Track -->
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#DAE3DC" />
    <SolidColorBrush x:Key="ThumbNormalBrush" Color="#A3B5AA" />
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#7A8F82" />

    <!-- Primary Button (Deep Forest Sage) -->
    <SolidColorBrush x:Key="ButtonPrimaryBackgroundBrush" Color="#335242" />
    <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonPrimaryBorderBrush" Color="#335242" />
    <SolidColorBrush x:Key="ButtonPrimaryHoverBackgroundBrush" Color="#284234" />
    <SolidColorBrush x:Key="ButtonPrimaryPressedBackgroundBrush" Color="#1D3327" />

    <!-- Secondary Button (Muted Sage) -->
    <SolidColorBrush x:Key="ButtonSecondaryBackgroundBrush" Color="#CCDCD2" />
    <SolidColorBrush x:Key="ButtonSecondaryForegroundBrush" Color="#1F2923" />
    <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#B5C7BB" />
    <SolidColorBrush x:Key="ButtonSecondaryHoverBackgroundBrush" Color="#BFCFC5" />
    <SolidColorBrush x:Key="ButtonSecondaryPressedBackgroundBrush" Color="#AFBFB5" />

    <!-- Danger Button -->
    <SolidColorBrush x:Key="ButtonDangerBackgroundBrush" Color="#B84A4A" />
    <SolidColorBrush x:Key="ButtonDangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonDangerBorderBrush" Color="#B84A4A" />
    <SolidColorBrush x:Key="ButtonDangerHoverBackgroundBrush" Color="#A13B3B" />
    <SolidColorBrush x:Key="ButtonDangerPressedBackgroundBrush" Color="#882D2D" />

    <!-- Danger Subdued -->
    <SolidColorBrush x:Key="ButtonDangerSubduedBackgroundBrush" Color="#FDEEEE" />
    <SolidColorBrush x:Key="ButtonDangerSubduedForegroundBrush" Color="#A13B3B" />
    <SolidColorBrush x:Key="ButtonDangerSubduedBorderBrush" Color="#F7C6C6" />
    <SolidColorBrush x:Key="ButtonDangerSubduedHoverBackgroundBrush" Color="#FCDADA" />
    <SolidColorBrush x:Key="ButtonDangerSubduedPressedBackgroundBrush" Color="#F7C6C6" />

    <!-- Accent Button (Eucalyptus / Muted Teal Green) -->
    <SolidColorBrush x:Key="ButtonAccentBackgroundBrush" Color="#4E876B" />
    <SolidColorBrush x:Key="ButtonAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonAccentBorderBrush" Color="#4E876B" />
    <SolidColorBrush x:Key="ButtonAccentHoverBackgroundBrush" Color="#3F7057" />
    <SolidColorBrush x:Key="ButtonAccentPressedBackgroundBrush" Color="#315944" />

    <!-- Badges & Status Brushes -->
    <SolidColorBrush x:Key="StrategyBadgeBackgroundBrush" Color="#DCE9E0" />
    <SolidColorBrush x:Key="StrategyBadgeBorderBrush" Color="#4E876B" />
    <SolidColorBrush x:Key="StrategyBadgeTextBrush" Color="#284234" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#3F7057" />

    <SolidColorBrush x:Key="PositiveBrush" Color="#2E6B47" />
    <SolidColorBrush x:Key="NegativeBrush" Color="#B84A4A" />
    <SolidColorBrush x:Key="GoodNumericHighlightBrush" Color="#2E6B47" />
    <SolidColorBrush x:Key="WarningNumericHighlightBrush" Color="#D97706" />
    <SolidColorBrush x:Key="BadNumericHighlightBrush" Color="#B84A4A" />

    <!-- Splitter Colors -->
    <SolidColorBrush x:Key="SplitterBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SplitterLineBrush" Color="#B5C7BB" />
    <SolidColorBrush x:Key="SplitterGripBrush" Color="#7A8F82" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#4E876B" />
    
    <!-- Tooltip Brushes (Sage Theme - Deep Forest Slate Surface) -->
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#1A2821" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#335242" />
    <SolidColorBrush x:Key="TooltipTextBrush" Color="#F2F5F3" />
    <SolidColorBrush x:Key="TooltipSecondaryTextBrush" Color="#A3B5AA" />
    <SolidColorBrush x:Key="TooltipHeaderBrush" Color="#73B08E" />
    <SolidColorBrush x:Key="TooltipBadgeBackgroundBrush" Color="#284234" />
    <SolidColorBrush x:Key="TooltipBadgeBorderBrush" Color="#4E876B" />
    <SolidColorBrush x:Key="TooltipBadgeTextBrush" Color="#CCDCD2" />
</ResourceDictionary>
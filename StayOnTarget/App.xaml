<Application x:Class="StayOnTarget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StayOnTarget"
             xmlns:converters="clr-namespace:StayOnTarget.Converters"
             xmlns:controls="clr-namespace:StayOnTarget.Controls"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:models="clr-namespace:StayOnTarget.Models"
             xmlns:helpers="clr-namespace:StayOnTarget.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:EnumToDisplayNameConverter x:Key="EnumToDisplayNameConverter" />
            <converters:LessThanConverter x:Key="LessThanConverter" />
            <converters:MultiBooleanToVisibilityConverter x:Key="MultiBooleanToVisibilityConverter" />
            <converters:MarkBillPaidVisibilityConverter x:Key="MarkBillPaidVisibilityConverter" />
            <converters:NullOrZeroToVisibilityConverter x:Key="NullOrZeroToVisibilityConverter" />
            <converters:SetContainsAccountIdConverter x:Key="SetContainsAccountIdConverter" />
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <converters:ProjectionAmountToBrushConverter x:Key="ProjectionAmountToBrushConverter" />
            <converters:ProjectionYearsLabelConverter x:Key="ProjectionYearsLabelConverter" />
            <converters:DoubleToDecimalConverter x:Key="DoubleToDecimalConverter" />
            <converters:AccountTypeToIconConverter x:Key="AccountIconConverter" />
            <converters:AmountToBrushConverter x:Key="AmountToBrushConverter" />
            <converters:BooleanAndToVisibilityConverter x:Key="BooleanAndToVisibilityConverter" />
            <converters:CategoryNameConverter x:Key="CategoryNameConverter" />
            <converters:NegativeToRedConverter x:Key="NegativeToRedConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:DeltaToBrushConverter x:Key="DeltaToBrushConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:AccountTypeToVisibilityConverter x:Key="AccountTypeToVisibilityConverter" />
            <converters:AbsoluteValueConverter x:Key="AbsoluteValueConverter" />
            <converters:VisibleForMortgageTypeConverter x:Key="VisibleForMortgageTypeConverter" />
            <converters:PaycheckFieldVisibilityConverter x:Key="PaycheckFieldVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter" />
            
            <ObjectDataProvider x:Key="EnumFrequency"
                                MethodName="GetValues"
                                ObjectType="{x:Type models:Frequency}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="models:Frequency" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource DataGridAltRowBackgroundBrush}" />
                <Setter Property="RowBackground" Value="{DynamicResource DataGridRowBackgroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DataGridRowForegroundBrush}" />
                <Setter Property="GridLinesVisibility" Value="All" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
            </Style>

            <Style TargetType="{x:Type DataGridRow}">
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#3B82F6" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                     Color="White" />
                </Style.Resources>
            </Style>

            <!-- Shared Amount Column Style -->
            <Style x:Key="TransactionAmountElementStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="Padding" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBucket}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource GridBucketForegroundBrush}" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSweep}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource GridSweepForegroundBrush}" />
                        <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Shared Standard Row Style -->
            <Style x:Key="ProjectionRowStyle" TargetType="{x:Type DataGridRow}">
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="LightGray" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPaycheck}" Value="True">
                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                        <Setter Property="BorderBrush" Value="{DynamicResource GridPeriodBorderBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            
            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Background" Value="{DynamicResource DataGridHeaderBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,6,8,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="SeparatorBrush" Value="{DynamicResource BorderColorBrush}" />
            </Style>

            <Style x:Key="RightAlignedHeaderStyle"
                   TargetType="{x:Type DataGridColumnHeader}"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">

                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
            <Style x:Key="CenterAlignedHeaderStyle"
                   TargetType="{x:Type DataGridColumnHeader}"
                   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">

                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <!-- 3. Implicit ScrollBar Style (Applies to Horizontal & Vertical automatically) -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="{DynamicResource TrackBackgroundBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <!-- Track automatically manages IsDirectionReversed based on ScrollBar Orientation when left unbound, 
                         or explicitly controlled via Triggers below -->
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{DynamicResource CustomScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Vertical ScrollBars in WPF must have IsDirectionReversed="True" on the Track -->
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomScrollThumb" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="true" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <!-- Visual representation of the draggable bar -->
                            <Border x:Name="rectangle"
                                    Background="{DynamicResource ThumbNormalBrush}"
                                    CornerRadius="4"
                                    Margin="2" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="rectangle" Property="Background"
                                            Value="{DynamicResource ThumbHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- <Style TargetType="DataGridRowHeader"> -->
            <!--     <Setter Property="Background" Value="Red" /> -->
            <!-- </Style> -->

            <Style x:Key="ModernUnderlineTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid x:Name="Panel" Background="Transparent" Margin="0,0,14,0" SnapsToDevicePixels="True">
                                <Border x:Name="Border" Padding="2,4,2,6">
                                    <ContentPresenter x:Name="ContentSite"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                                <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                        Background="Transparent" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="#0284C7" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ContentSite" Property="TextElement.Foreground"
                                            Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Underline" Property="Background" Value="#3B82F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Base Button Style (Handles Padding, Template, Triggers) -->
            <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="contentPresenter"
                                                  Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 1. PRIMARY BUTTON STYLE -->
            <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryPressedBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 2. SECONDARY BUTTON STYLE -->
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonSecondaryPressedBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Explicit Key for explicit usage -->
            <Style x:Key="SecondaryToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="contentPresenter"
                                                  Focusable="False"
                                                  HorizontalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Mouse Over State -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background"
                                            Value="{DynamicResource SidebarHoverBrush}" />
                                </Trigger>
                                <!-- Checked State (Active Filter) -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3B82F6" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. DANGER BUTTON STYLE -->
            <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ButtonDangerBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonDangerForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonDangerHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonDangerPressedBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 4. DANGER SUBDUED BUTTON STYLE -->
            <Style x:Key="DangerSubduedButtonStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ButtonDangerSubduedBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonDangerSubduedForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerSubduedBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonDangerSubduedHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource ButtonDangerSubduedPressedBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ACCENT BUTTON STYLE (Wizard Next / Finish) -->
            <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource ButtonAccentBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource ButtonAccentForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonAccentBorderBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonAccentHoverBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonAccentHoverBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ButtonAccentPressedBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ButtonAccentPressedBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ModernGridSplitterStyle" TargetType="{x:Type GridSplitter}">
                <Setter Property="Background" Value="{DynamicResource SplitterBackgroundBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Width" Value="6" />
                <Setter Property="Cursor" Value="SizeWE" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    Width="{TemplateBinding Width}"
                                    HorizontalAlignment="Center">
                                <Grid x:Name="GridContainer" HorizontalAlignment="Center">
                                    <!-- Center Divider Line -->
                                    <Rectangle x:Name="DividerLine"
                                               Width="1"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Stretch"
                                               Fill="{DynamicResource SplitterLineBrush}" />

                                    <!-- Center Grip Indicator (3 Vertical Dots) -->
                                    <StackPanel x:Name="GripHandle"
                                                Orientation="Vertical"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <Ellipse x:Name="Dot1" Width="3" Height="3" Margin="0,2"
                                                 Fill="{DynamicResource SplitterGripBrush}" />
                                        <Ellipse x:Name="Dot2" Width="3" Height="3" Margin="0,2"
                                                 Fill="{DynamicResource SplitterGripBrush}" />
                                        <Ellipse x:Name="Dot3" Width="3" Height="3" Margin="0,2"
                                                 Fill="{DynamicResource SplitterGripBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Interactive Triggers -->
                            <ControlTemplate.Triggers>
                                <!-- Hover State -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="DividerLine" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="Dot1" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="Dot2" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="Dot3" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                </Trigger>

                                <!-- Active Drag / Pressed State -->
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="DividerLine" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="DividerLine" Property="Width" Value="2" />
                                    <Setter TargetName="Dot1" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="Dot2" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                    <Setter TargetName="Dot3" Property="Fill"
                                            Value="{DynamicResource SplitterHoverBrush}" />
                                </Trigger>

                                <!-- Horizontal Orientation Adapter -->
                                <Trigger Property="ResizeDirection" Value="Rows">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="6" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Cursor" Value="SizeNS" />
                                    <Setter TargetName="DividerLine" Property="Width" Value="Auto" />
                                    <Setter TargetName="DividerLine" Property="Height" Value="1" />
                                    <Setter TargetName="GripHandle" Property="Orientation" Value="Horizontal" />
                                    <Setter TargetName="Dot1" Property="Margin" Value="2,0" />
                                    <Setter TargetName="Dot2" Property="Margin" Value="2,0" />
                                    <Setter TargetName="Dot3" Property="Margin" Value="2,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StyledLabel" TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            
            <Style x:Key="StyledRadioButton" TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!-- <Style x:Key="StyledCheckBox" TargetType="{x:Type CheckBox}"> -->
            <!--     <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /> -->
            <!-- </Style> -->
            <!-- -->
            <Style x:Key="StyledTextBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="StyledSecondaryTextBlock" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            </Style>

            <!-- IMPLICIT TEXTBOX STYLE (Fixes NumericTextBox & standard TextBoxes) -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryAccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Explicit style for NumericTextBox subclass -->
            <Style TargetType="{x:Type controls:NumericTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <!-- IMPLICIT LISTBOXITEM STYLE -->
<Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<!-- IMPLICIT LISTBOX STYLE -->
<Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource DataGridRowBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DataGridRowForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
            
            <!-- 1. IMPLICIT COMBOBOXITEM STYLE -->
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource SidebarHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource SidebarSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 2. BASE COMBOBOX STYLE WITH EXPLICIT TEMPLATE -->
            <!-- IMPLICIT COMBOBOX STYLE (Supports both standard and editable IsEditable="True") -->
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>

                                <!-- Toggle Button / Background Container -->
                                <ToggleButton x:Name="ToggleButton"
                                              Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="templateRoot"
                                                    Background="{DynamicResource SurfaceBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Border x:Name="splitBorder"
                                                        Width="30"
                                                        HorizontalAlignment="Right"
                                                        BorderThickness="0"
                                                        Background="Transparent">
                                                    <!-- Arrow Icon -->
                                                    <Path x:Name="arrow"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="F1 M 0,0 L 4,4 L 8,0 Z"
                                                          Fill="{DynamicResource PrimaryTextBrush}" />
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="templateRoot" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Non-Editable View: Displays Selected Item -->
                                <ContentPresenter x:Name="contentTemplate"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  IsHitTestVisible="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                                <!-- Editable View: WPF expects PART_EditableTextBox for typing -->
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Margin="0"
                                         Padding="{TemplateBinding Padding}"
                                         HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                         Background="Transparent"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderThickness="0"
                                         MinHeight="0"
                                         Height="Auto"
                                         Focusable="True"
                                         Visibility="Collapsed">
                                </TextBox>

                                <!-- Popup Dropdown List -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Margin="1"
                                       PopupAnimation="Slide"
                                       Placement="Bottom">
                                    <Border x:Name="dropDownBorder"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                            Background="{DynamicResource SurfaceBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                        <ScrollViewer x:Name="DropDownScrollViewer">
                                            <ItemsPresenter x:Name="ItemsPresenter"
                                                            KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Switch between ContentPresenter and TextBox when IsEditable="True" -->
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="contentTemplate" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. ENUM COMBOBOX STYLE -->
            <Style x:Key="StyledEnumComboBox" TargetType="{x:Type ComboBox}"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            
            <!-- Base ToolTip Container Style -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Background" Value="{DynamicResource TooltipBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TooltipTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TooltipBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="3"
                                                      Opacity="0.35"
                                                      Color="Black" />
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tooltip Internal Typography & Element Styles -->
            <Style x:Key="TooltipHeaderTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TooltipHeaderBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="TooltipPrimaryTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TooltipTextBrush}" />
            </Style>

            <Style x:Key="TooltipSecondaryTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TooltipSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="TooltipSeparatorStyle" TargetType="{x:Type Separator}">
                <Setter Property="Background" Value="{DynamicResource TooltipBorderBrush}" />
                <Setter Property="Margin" Value="0,6,0,6" />
            </Style>

            <!-- Tooltip Badge / Pill Container Style -->
            <Style x:Key="TooltipBadgeBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{DynamicResource TooltipBadgeBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TooltipBadgeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,2" />
            </Style>

            <Style x:Key="TooltipBadgeTextBlockStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TooltipBadgeTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
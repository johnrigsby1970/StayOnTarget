<Window x:Class="StayOnTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StayOnTarget"
        xmlns:converters="clr-namespace:StayOnTarget.Converters"
        xmlns:vm="clr-namespace:StayOnTarget.ViewModels"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:StayOnTarget.Models"
        xmlns:System="clr-namespace:System;assembly=System.Runtime"
        xmlns:helpers="clr-namespace:StayOnTarget"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:iconPacks="http://mahapps.com"
        xmlns:iconPacks1="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:helpers1="clr-namespace:StayOnTarget.Helpers"
        xmlns:controls="clr-namespace:StayOnTarget.Controls"
        xmlns:userControls="clr-namespace:StayOnTarget.ViewModels.UserControls"
        mc:Ignorable="d"
        Title="Stay On Target" Height="600" Width="1000" MinWidth="1000"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowState="Maximized">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>

        <ObjectDataProvider x:Key="EnumSurplusCalculationMethod"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SnowballStrategyOptions+SurplusCalculationMethod" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="InnerTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6,0,0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <CollectionViewSource x:Key="SortedCurrentPeriodTransactions"
                              Source="{Binding CurrentPeriodTransactions}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="TransactionDate" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <ObjectDataProvider x:Key="EnumSurplusAllocationTarget"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SurplusAllocationTarget" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EnumSnowballSortStrategy"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:SnowballSortStrategy" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EnumInvestmentStrategy"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:InvestmentStrategy" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Grid.ColumnSpan="2"
              Background="{DynamicResource SurfaceBackgroundBrush}"
              Foreground="{DynamicResource PrimaryTextBrush}">
            <Menu.Resources>
                <!-- Applies ONLY to MenuItems inside THIS menu -->
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File">
                <MenuItem Header="_Export Transactions..." Command="{Binding ExportTransactionsCommand}" />
                <MenuItem Header="_Backup" Command="{Binding BackupCommand}" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_SetTheme" Command="{Binding SetThemeCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Toast Notification Overlay -->
        <ItemsControl Grid.Row="1" Grid.RowSpan="2" ItemsSource="{Binding Toasts}" VerticalAlignment="Top"
                      HorizontalAlignment="Right" Margin="0,10,20,0" Panel.ZIndex="1000">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,0,0,10" Padding="10" Width="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="X" Command="{Binding CloseCommand}"
                                    Width="20" Height="20" Margin="5,0,0,0" VerticalAlignment="Top"
                                    Background="{Binding Background}" BorderThickness="0" FontWeight="Bold"
                                    Foreground="{Binding Border}" />
                            <TextBlock Style="{DynamicResource    StyledTextBlock}" Text="{Binding Message}"
                                       TextWrapping="Wrap" Foreground="{Binding Text}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="450" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" MinWidth="450" />
            </Grid.ColumnDefinitions>

            <!-- Left Workspace: Modern Left-Rail Navigation + Content View -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Navigation Rail -->
                    <ColumnDefinition Width="*" />    <!-- Active View Area -->
                </Grid.ColumnDefinitions>

                <!-- 1. LEFT NAVIGATION RAIL -->
                <Border x:Name="SidebarBorder" Grid.Column="0"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="0,0,1,0"
                        Margin="0,0,8,0">
                    <ListBox SelectedIndex="{Binding SelectedOuterTabIndex, FallbackValue=0}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="2,2" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    CornerRadius="6"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SidebarSelectedBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background"
                                                            Value="{DynamicResource SidebarHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem Content="Dashboard" ToolTip="Current Period Overview" />
                        <ListBoxItem Content="Accounts" />
                        <ListBoxItem Content="Ledger" />
                        <ListBoxItem Content="Bills" />
                        <ListBoxItem Content="Envelopes" />
                        <ListBoxItem Content="Categories" />
                        <ListBoxItem Content="Paychecks" />
                    </ListBox>
                </Border>

                <!-- 2. MAIN ACTIVE VIEW PANEL -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Content Switcher replacing top TabControl -->
                    <ContentControl Grid.Row="0">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <!-- Default (Index 0): Dashboard / Current Period & Cash Requirements View -->
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel Margin="10">

                                                <!-- Header Title -->
                                                <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                           Text="Cash Overview &amp; Planned Money"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,12" />

                                                <!-- CASH READINESS & ACTION SUGGESTION CARD -->
                                                <Border Background="{Binding ReadinessStatusBackgroundBrush}"
                                                        BorderBrush="{Binding ReadinessStatusBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="14"
                                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,6">
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="{Binding ReadinessStatusTitle}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       Foreground="{Binding ReadinessStatusHeaderBrush}"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock
                                                                Text="{Binding LowestProjectedCheckingBalance, StringFormat='Lowest Checking Point: {0:C}'}"
                                                                FontSize="11" FontWeight="SemiBold"
                                                                Style="{DynamicResource    StyledSecondaryTextBlock}"

                                                                DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                VerticalAlignment="Center" />
                                                        </DockPanel>

                                                        <TextBlock
                                                            Foreground="{DynamicResource ReadinessStatusTextBrush}"
                                                            Text="{Binding ReadinessSuggestionMessage}"
                                                            FontSize="12"
                                                            TextWrapping="Wrap" LineHeight="18" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- 1. TOP CARDS: LIQUID CASH vs UNALLOCATED SURPLUS -->
                                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                                    <!-- Total Liquid Cash -->
                                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                                            Margin="0,0,6,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Total Cash on Hand" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Style="{DynamicResource    StyledSecondaryTextBlock}" />
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="{Binding TotalLiquidCash, StringFormat=C}"
                                                                       FontSize="24" FontWeight="Bold"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock Text="Checking &amp; Savings Total Balance"
                                                                       FontSize="11"
                                                                       Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Unallocated / Surplus Cash -->
                                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="14"
                                                            Margin="6,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="Available Money" FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Style="{DynamicResource    StyledSecondaryTextBlock}" />
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Text="{Binding UnallocatedSurplusCash, StringFormat=C}"
                                                                       FontSize="24" FontWeight="Bold"
                                                                       Foreground="{DynamicResource GoodNumericHighlightBrush}"
                                                                       Margin="0,4,0,0" />
                                                            <TextBlock
                                                                Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                Text="Available to Invest or Pay Down Debt"
                                                                FontSize="11"
                                                                Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <!-- 2. REQUIRED ACCOUNTS RESERVES BREAKDOWN -->
                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16"
                                                        Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                   Text="Money Already Spoken For"
                                                                   FontSize="14" FontWeight="SemiBold"

                                                                   Margin="0,0,0,12" />

                                                        <!-- 1. Minimum Balance Cushion -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                    Text="Minimum Balance Setting"
                                                                    FontWeight="Medium" />
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                    Text="Cash kept in checking/savings as a safety buffer"
                                                                    FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding EnvelopeFloorRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsMinimumBalanceCushionBreached}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 2. Savings Goals & Future Funds -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                    Text="Savings Goals &amp; Future Funds"
                                                                    FontWeight="Medium" />
                                                                <TextBlock
                                                                    Text="Money saved and put aside for larger or upcoming plans"
                                                                    FontSize="11"
                                                                    Style="{DynamicResource    StyledSecondaryTextBlock}" />
                                                            </StackPanel>
                                                            <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                                       Grid.Column="1"
                                                                       Text="{Binding AccumulatingDrawdownReserves, StringFormat=C}"
                                                                       FontWeight="Bold"

                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 3. Unpaid Period Bills -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                    Text="Upcoming Bills"
                                                                    FontWeight="Medium" />
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                    Text="Required balance to satisfy remaining bills this period"
                                                                    FontSize="11" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding UpcomingBillsRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsUnpaidBillsAlert}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- 4. Remaining Everyday Budget -->
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                    Text="Remaining Planned Spending"
                                                                    FontWeight="Medium" />
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                    Text="Required balance to satisfy remaining budgeted envelope spending this period"
                                                                    FontSize="11"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding UnspentStandardEnvelopeRequirements, StringFormat=C}"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <!-- Default Neutral Color -->
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <!-- Warning Trigger: Amber/Orange when an envelope is overspent -->
                                                                            <DataTrigger
                                                                                Binding="{Binding HasOverspentEnvelopes}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource WarningNumericHighlightBrush}" />
                                                                            </DataTrigger>
                                                                            <!-- Critical Trigger: Red if total cash can't cover committed reserves -->
                                                                            <DataTrigger
                                                                                Binding="{Binding IsTotalCommittedFundsBreached}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>

                                                        <Separator Background="{DynamicResource BorderColorBrush}"
                                                                   Margin="0,8" Opacity="0.5" />

                                                        <!-- Total Required Reserves Summary Row -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledTextBlock}"
                                                                    Text="Total Reserved:"
                                                                    FontWeight="Bold" FontSize="13" />
                                                                <TextBlock
                                                                    Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                                    Text="Total cash reserved for balance safety cushions, savings goals, bills, and everyday budget"
                                                                    FontSize="11"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding TotalRequiredReserves, StringFormat=C}"
                                                                       FontWeight="Bold" FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <!-- Set Default Foreground here in the style setter, NOT directly on the TextBlock tag -->
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource PrimaryTextBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding IsTotalCommittedFundsBreached}"
                                                                                Value="True">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{DynamicResource BadNumericHighlightBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- WHERE EXTRA CASH GOES -->
                                                <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                                        Visibility="{Binding SnowballOptions.EnableSnowball, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <StackPanel>
                                                        <!-- Header with Snowball Strategy Indicator -->
                                                        <DockPanel Margin="0,0,0,12">

                                                            <!-- Strategy Pill Badge (Docked Right) -->
                                                            <Border
                                                                Background="{DynamicResource StrategyBadgeBackgroundBrush}"
                                                                BorderBrush="{DynamicResource StrategyBadgeBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="8,3"
                                                                DockPanel.Dock="Right"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Text="{Binding StrategyDisplayName, TargetNullValue='Snowball Strategy'}"
                                                                    FontSize="10"
                                                                    FontWeight="Bold"
                                                                    Foreground="{DynamicResource StrategyBadgeTextBrush}"
                                                                    VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Title & Main Icon (Docked Left) -->
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <!-- Large Snowball / Snowflake Icon -->
                                                                <Viewbox Width="22" Height="22" Margin="0,0,8,0"
                                                                         VerticalAlignment="Center">
                                                                    <Path
                                                                        Data="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93M7 12l-2-2m2 2l-2 2m10-2l2-2m-2 2l2 2m-5-5l-2-2m2 2l2-2m-2 10l-2 2m2-2l2 2"
                                                                        Stroke="{DynamicResource StrategyBadgeBorderBrush}"
                                                                        StrokeThickness="1.75"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        StrokeLineJoin="Round"
                                                                        Stretch="Uniform" />
                                                                </Viewbox>

                                                                <TextBlock
                                                                    Style="{DynamicResource StyledTextBlock}"
                                                                    Text="Where Extra Cash Goes"
                                                                    FontSize="14"
                                                                    FontWeight="SemiBold"
                                                                    VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <UniformGrid Columns="3">
                                                            <!-- 1. Debt Target -->
                                                            <Border
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10"
                                                                Margin="0,0,4,0">
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Debt Payoff Suggestion" FontSize="11"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledTextBlock}"
                                                                        Text="{Binding RecommendedDebtAllocation, StringFormat=C}"
                                                                        FontSize="16" FontWeight="Bold"
                                                                        Margin="0,4,0,0" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Put towards debt payoff"
                                                                        FontSize="10"
                                                                        Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 2. Investment Target -->
                                                            <Border
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10"
                                                                Margin="2,0,2,0">
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Recommended Investing"
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledTextBlock}"
                                                                        Text="{Binding RecommendedInvestmentAllocation, StringFormat=C}"
                                                                        FontSize="16" FontWeight="Bold"
                                                                        Margin="0,4,0,0" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Put towards growth accounts"
                                                                        FontSize="10"
                                                                        Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- 3. Retained Checking Cushion -->
                                                            <Border
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                                BorderThickness="1" CornerRadius="6" Padding="10"
                                                                Margin="4,0,0,0">
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Free Cash"
                                                                        FontSize="11"
                                                                        FontWeight="SemiBold" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledTextBlock}"
                                                                        Text="{Binding RetainedCheckingBuffer, StringFormat=C}"
                                                                        FontSize="16"
                                                                        FontWeight="Bold"
                                                                        Margin="0,4,0,0" />
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                        Text="Play $$, fun funds, be good"
                                                                        FontSize="10"
                                                                        Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </UniformGrid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Index 1: Ledger View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="2">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Top"
                                                                Margin="5"
                                                                HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Margin="5">
                                                            <CheckBox Content="Show by Month"
                                                                      IsChecked="{Binding ShowByMonth}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="5"
                                                                      Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <ComboBox ItemsSource="{Binding PeriodPaychecks}"
                                                                      DisplayMemberPath="Name"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding SelectedPeriodPaycheckId}"
                                                                      Width="150" Margin="5"
                                                                      Visibility="{Binding ShowByMonth, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center">
                                                            <Button Content=" &lt; "
                                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding PrevPeriodCommand}"
                                                                    Width="40"
                                                                    Margin="5" />
                                                            <TextBlock Style="{DynamicResource StyledTextBlock}"
                                                                       Text="{Binding PeriodDisplay}"
                                                                       VerticalAlignment="Center"
                                                                       FontWeight="Bold"
                                                                       FontSize="14" Margin="10,0" />
                                                            <Button Content=" &gt; "
                                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                                    Command="{Binding NextPeriodCommand}"
                                                                    Width="40"
                                                                    Margin="5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TabControl Style="{DynamicResource InnerTabControlStyle}"
                                                                ItemContainerStyle="{DynamicResource ModernUnderlineTabItemStyle}"
                                                                SelectedIndex="{Binding SelectedInnerTabIndex}">
                                                        <TabItem Header="Transaction">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="0,5,0,0">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeleteSelectedTransactionCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button"
                                                                                    BasedOn="{StaticResource DangerButtonStyle}">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Visible" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger
                                                                                            Binding="{Binding SelectedTransaction.TransactionId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                                            Value="Collapsed">
                                                                                            <Setter
                                                                                                Property="Visibility"
                                                                                                Value="Collapsed" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="0,5,0,0">
                                                                        <Button Content="Add"
                                                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                                                Command="{Binding AddTransactionCommand}"
                                                                                Visibility="{Binding IsNotEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                        <Button Content="Edit"
                                                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                                                Command="{Binding EditTransactionCommand}"
                                                                                Width="80"
                                                                                Margin="2">
                                                                            <Button.Visibility>
                                                                                <MultiBinding
                                                                                    Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                                    <Binding
                                                                                        Path="CanEditTransaction" />
                                                                                    <Binding
                                                                                        Path="IsNotEditingTransaction" />
                                                                                </MultiBinding>
                                                                            </Button.Visibility>
                                                                        </Button>
                                                                        <Button Content="Save"
                                                                                Command="{Binding SaveTransactionCommand}"
                                                                                Width="80" Margin="2"
                                                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                                                IsEnabled="{Binding IsEditingTransactionEnabled}"
                                                                                Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Button Content="Cancel"
                                                                                Command="{Binding CancelTransactionCommand}"
                                                                                Width="80" Margin="2"
                                                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                                                Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>

                                                                    <DataGrid Grid.Row="0"
                                                                              ItemsSource="{Binding Source={StaticResource SortedCurrentPeriodTransactions}}"
                                                                              SelectedItem="{Binding SelectedTransaction}"
                                                                              AutoGenerateColumns="False"
                                                                              HorizontalScrollBarVisibility="Auto"
                                                                              CanUserAddRows="False"
                                                                              IsReadOnly="True">

                                                                        <DataGrid.RowStyle>
                                                                            <Style TargetType="DataGridRow"
                                                                                    BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                                <!-- 1. Pass the DataGrid DataContext (MainViewModel) to the row's Tag property -->
                                                                                <Setter Property="Tag"
                                                                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <!-- 2. Bind OpenCommand via PlacementTarget.Tag -->
                                                                                        <!-- Note: Background, BorderBrush, BorderThickness, and Padding are now handled automatically by the implicit ToolTip style -->
                                                                                        <ToolTip x:Name="RowToolTip"
                                                                                            helpers1:ToolTipBehavior.OpenCommand="{Binding PlacementTarget.Tag.OnTransactionRowHoveredCommand, RelativeSource={RelativeSource Self}}"
                                                                                            helpers1:ToolTipBehavior.OpenCommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                            <StackPanel Width="260">
                                                                                                <!-- Header / Payee Name -->
                                                                                                <TextBlock
                                                                                                    Text="{Binding Description}"
                                                                                                    Style="{StaticResource TooltipHeaderTextBlockStyle}"
                                                                                                    Margin="0,0,0,6" />

                                                                                                <Separator
                                                                                                    Style="{StaticResource TooltipSeparatorStyle}" />

                                                                                                <!-- Analytics Summary -->
                                                                                                <Grid
                                                                                                    TextBlock.Foreground="{DynamicResource TooltipSecondaryTextBrush}">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition
                                                                                                            Width="*" />
                                                                                                        <ColumnDefinition
                                                                                                            Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Grid.RowDefinitions>
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                    </Grid.RowDefinitions>

                                                                                                    <!-- 24-Mo Avg -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="0"
                                                                                                        Text="24-Mo Avg Spend:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AverageSpend, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="0"
                                                                                                        Text="24-Mo Avg Biweekly Spend:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AverageBiweeklySpend, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Suggested Budget Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Rec. Target / Mo:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.SuggestedBudget, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />

                                                                                                    <!-- Suggested Budget Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Rec. Target / Biweekly:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.SuggestedBiweeklyBudget, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />

                                                                                                    <!-- Annual Trend -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Annual Inflation:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AnnualizedInflationPercentage, FallbackValue='0.0%', StringFormat='{}{0:+0.0%;-0.0%;0.0%}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Suggested Budget Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="5"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Average / Purchase:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="5"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AveragePerPurchase, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />

                                                                                                    <!-- Suggested Budget Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="6"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Average Purchases / Month:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="6"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AveragePurchasesPerMonth, FallbackValue='0.00', StringFormat='{}{0:0.00}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />
                                                                                                </Grid>

                                                                                                <!-- Tip Callout -->
                                                                                                <TextBlock
                                                                                                    FontSize="10.5"
                                                                                                    Margin="0,8,0,4"
                                                                                                    Foreground="{DynamicResource TooltipSecondaryTextBrush}"
                                                                                                    FontStyle="Italic"
                                                                                                    TextWrapping="Wrap">
                                                                                                    <Run
                                                                                                        Text="Tip: To reduce spending, keep purchases at or below " />
                                                                                                    <Run
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AveragePurchasesPerMonth, Mode=OneWay, StringFormat='{}{0:0.0}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                    <Run
                                                                                                        Text=" / mo while keeping each checkout under " />
                                                                                                    <Run
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.AveragePerPurchase, Mode=OneWay, StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                    <Run
                                                                                                        Text=". That is your target." />
                                                                                                </TextBlock>

                                                                                                <!-- Seasonality Surge Banner -->
                                                                                                <Border
                                                                                                    Style="{StaticResource TooltipBadgeBorderStyle}"
                                                                                                    Margin="0,6,0,0"
                                                                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.IsSeasonal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                    <TextBlock
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredPayeeMetrics.PeakSeasonSummary}"
                                                                                                        Style="{StaticResource TooltipBadgeTextBlockStyle}"
                                                                                                        Foreground="{DynamicResource WarningNumericHighlightBrush}"
                                                                                                        TextWrapping="Wrap" />
                                                                                                </Border>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>

                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding
                                                                                MouseAction="LeftDoubleClick"
                                                                                Command="{Binding EditTransactionCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn
                                                                                Header="Posting Date"
                                                                                HeaderStyle="{DynamicResource CenterAlignedHeaderStyle}"
                                                                                Binding="{Binding TransactionDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                                IsReadOnly="False" Width="90">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Center" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Description"
                                                                                Binding="{Binding Description}"
                                                                                Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Amount"
                                                                                    HeaderStyle="{DynamicResource RightAlignedHeaderStyle}"
                                                                                    Binding="{Binding Amount, StringFormat=C}"
                                                                                    Width="85" MinWidth="80">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                        <Setter
                                                                                            Property="Foreground"
                                                                                            Value="{Binding Amount, Converter={StaticResource AmountToBrushConverter}}" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn Header="From"
                                                                                    Binding="{Binding AccountName}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="To"
                                                                                    Binding="{Binding ToAccountName}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Category"
                                                                                    Binding="{Binding Converter={StaticResource CategoryNameConverter}}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                            <DataGridTextColumn Header="Memo"
                                                                                    Binding="{Binding Memo}"
                                                                                    Width="Auto" MinWidth="100" />
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                        <TabItem Header="Bills">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left" Margin="5">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeletePeriodBillCommand}"
                                                                                Width="80"
                                                                                Margin="2"
                                                                                Style="{DynamicResource DangerButtonStyle}"
                                                                                Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="5">
                                                                        <Button Content="Edit"
                                                                                Command="{Binding EditPeriodBillCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Visibility>
                                                                                <MultiBinding
                                                                                    Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                                    <Binding
                                                                                        Path="CanEditPeriodBill" />
                                                                                    <Binding
                                                                                        Path="IsNotEditingPeriodBill" />
                                                                                </MultiBinding>
                                                                            </Button.Visibility>
                                                                        </Button>
                                                                        <Button Content="Save"
                                                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                                                Command="{Binding SavePeriodBillCommand}"
                                                                                Width="80"
                                                                                Margin="2"
                                                                                Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                        <Button Content="Cancel"
                                                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                                                Command="{Binding CancelPeriodBillCommand}"
                                                                                Width="80" Margin="2"
                                                                                Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock
                                                                        Style="{DynamicResource StyledTextBlock}"
                                                                        Grid.Row="0" Margin="5"
                                                                        TextWrapping="Wrap" Height="Auto"
                                                                        Visibility="{Binding IsBillDescriptionExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                        Current period bill estimated payments, actual paid amounts, and overrides from default estimates. To change estimates, use the bills menu on the left to change estimated payments for future spending.
                                                                    </TextBlock>

                                                                    <DataGrid Grid.Row="1"
                                                                              ItemsSource="{Binding CurrentPeriodBills}"
                                                                              SelectedItem="{Binding SelectedPeriodBill}"
                                                                              AutoGenerateColumns="False"
                                                                              CanUserAddRows="False">
                                                                        <DataGrid.RowStyle>
                                                                            <Style TargetType="{x:Type DataGridRow}"
                                                                                    BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                                <!-- Pass MainViewModel to row Tag property -->
                                                                                <Setter Property="Tag"
                                                                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <!-- Note: Background, BorderBrush, BorderThickness, and Padding are now handled automatically by the implicit ToolTip style -->
                                                                                        <ToolTip x:Name="BillToolTip"
                                                                                            helpers1:ToolTipBehavior.OpenCommand="{Binding PlacementTarget.Tag.OnBillRowHoveredCommand, RelativeSource={RelativeSource Self}}"
                                                                                            helpers1:ToolTipBehavior.OpenCommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                            <StackPanel Width="270">
                                                                                                <!-- Header / Bill Name -->
                                                                                                <TextBlock
                                                                                                    Text="{Binding BillName}"
                                                                                                    Style="{StaticResource TooltipHeaderTextBlockStyle}"
                                                                                                    Margin="0,0,0,6" />

                                                                                                <Separator
                                                                                                    Style="{StaticResource TooltipSeparatorStyle}" />

                                                                                                <!-- Analytics Summary -->
                                                                                                <Grid
                                                                                                    TextBlock.Foreground="{DynamicResource TooltipSecondaryTextBrush}">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition
                                                                                                            Width="*" />
                                                                                                        <ColumnDefinition
                                                                                                            Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Grid.RowDefinitions>
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                    </Grid.RowDefinitions>

                                                                                                    <!-- 24-Mo Avg Spend -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="0"
                                                                                                        Text="24-Mo Avg Monthly:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.AverageSpend, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Peak Spend -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="0"
                                                                                                        Text="24-Mo Peak Amount:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.PeakSpend, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Suggested Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Rec. Monthly Target:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.SuggestedBudget, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />

                                                                                                    <!-- Annual Inflation -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Annual Inflation:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.AnnualizedInflationPercentage, FallbackValue='0.0%', StringFormat='{}{0:+0.0%;-0.0%;0.0%}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Outlier Cap -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Outlier Threshold:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.OutlierThreshold, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                </Grid>

                                                                                                <!-- Seasonal Banner -->
                                                                                                <Border
                                                                                                    Style="{StaticResource TooltipBadgeBorderStyle}"
                                                                                                    Margin="0,8,0,0"
                                                                                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.IsSeasonal, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                    <TextBlock
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBillMetrics.PeakSeasonSummary}"
                                                                                                        Style="{StaticResource TooltipBadgeTextBlockStyle}"
                                                                                                        Foreground="{DynamicResource WarningNumericHighlightBrush}"
                                                                                                        TextWrapping="Wrap" />
                                                                                                </Border>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </Setter.Value>
                                                                                </Setter>

                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding HasActualAmount}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="{DynamicResource GridStatusOptimalBackgroundBrush}" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="{DynamicResource SecondaryTextBrush}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding BudgetExceeded}"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="{DynamicResource GridStatusDeficitBackgroundBrush}" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="{DynamicResource SecondaryTextBrush}" />
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsSelected"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                        <DataGrid.CellStyle>
                                                                            <Style TargetType="DataGridCell">
                                                                                <Setter Property="Foreground"
                                                                                    Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
                                                                                <Setter Property="Background"
                                                                                    Value="Transparent" />
                                                                                <Setter Property="BorderThickness"
                                                                                    Value="0" />
                                                                            </Style>
                                                                        </DataGrid.CellStyle>
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding
                                                                                MouseAction="LeftDoubleClick"
                                                                                Command="{Binding EditPeriodBillCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn Header="Bill"
                                                                                    Width="*">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid Margin="2">
                                                                                            <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition
                                                                                                    Width="*" />
                                                                                                <ColumnDefinition
                                                                                                    Width="Auto" />
                                                                                            </Grid.ColumnDefinitions>
                                                                                            <TextBlock
                                                                                                Style="{DynamicResource StyledTextBlock}"
                                                                                                Grid.Column="0"
                                                                                                Text="{Binding BillName}"
                                                                                                FontWeight="SemiBold"
                                                                                                TextTrimming="CharacterEllipsis"
                                                                                                VerticalAlignment="Center">

                                                                                            </TextBlock>
                                                                                            <TextBlock
                                                                                                Style="{DynamicResource StyledTextBlock}"
                                                                                                Grid.Column="1"
                                                                                                Visibility="{Binding Converter={StaticResource MarkBillPaidVisibilityConverter}}"
                                                                                                Margin="6,0,0,0"
                                                                                                VerticalAlignment="Center">
                                                                                                <Hyperlink
                                                                                                    Command="{Binding DataContext.PayPeriodBillCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                                                    CommandParameter="{Binding}">
                                                                                                    Enter Payment
                                                                                                </Hyperlink>
                                                                                            </TextBlock>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
                                                                            <DataGridTextColumn Header="Due Date"
                                                                                    HeaderStyle="{DynamicResource    CenterAlignedHeaderStyle}"
                                                                                    Binding="{Binding DueDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                                                    IsReadOnly="False"
                                                                                    Width="80">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Center" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Expected Amount"
                                                                                Binding="{Binding ActualAmount, StringFormat=C}"
                                                                                Width="100">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                            <DataGridTextColumn
                                                                                Header="Actual Amount"
                                                                                Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                                IsReadOnly="True"
                                                                                Width="100">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                    <StackPanel
                                                                        Grid.Row="2"
                                                                        Margin="10"
                                                                        Visibility="{Binding IsEditingPeriodBill, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Style="{DynamicResource    StyledTextBlock}"
                                                                            Text="Edit Period Bill"
                                                                            FontWeight="Bold"
                                                                            Margin="0,0,0,5" />
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="0"
                                                                                Content="Name:" />
                                                                            <TextBox Grid.Column="1"
                                                                                    Text="{Binding EditingPeriodBillClone.BillName, UpdateSourceTrigger=PropertyChanged}"
                                                                                    IsEnabled="False"
                                                                                    Margin="5" />
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="2" Content="Budgeted:" />
                                                                            <controls:NumericTextBox
                                                                                Grid.Column="3"
                                                                                Text="{Binding EditingPeriodBillClone.ActualAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                        <TabItem Header="Envelopes">
                                                            <DockPanel>
                                                                <Grid DockPanel.Dock="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Left"
                                                                            Margin="5">
                                                                        <Button Content="Delete"
                                                                                Command="{Binding DeletePeriodBucketCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Style>
                                                                                <Style TargetType="Button"
                                                                                    BasedOn="{StaticResource DangerButtonStyle}">
                                                                                    <Setter Property="Visibility"
                                                                                        Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <MultiDataTrigger>
                                                                                            <MultiDataTrigger.Conditions>
                                                                                                <Condition
                                                                                                    Binding="{Binding IsEditingPeriodBucket}"
                                                                                                    Value="True" />
                                                                                                <Condition
                                                                                                    Binding="{Binding EditingPeriodBucketClone.Id, Converter={StaticResource NullOrZeroToVisibilityConverter}}"
                                                                                                    Value="Visible" />
                                                                                            </MultiDataTrigger.Conditions>
                                                                                            <Setter
                                                                                                Property="Visibility"
                                                                                                Value="Visible" />
                                                                                        </MultiDataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Button.Style>
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="5">
                                                                        <Button Content="Edit"
                                                                                Command="{Binding EditPeriodBucketCommand}"
                                                                                Width="80" Margin="2">
                                                                            <Button.Visibility>
                                                                                <MultiBinding
                                                                                    Converter="{StaticResource BooleanAndToVisibilityConverter}">
                                                                                    <Binding
                                                                                        Path="CanEditPeriodBucket" />
                                                                                    <Binding
                                                                                        Path="IsNotEditingPeriodBucket" />
                                                                                </MultiBinding>
                                                                            </Button.Visibility>
                                                                        </Button>
                                                                        <Button Content="Save"
                                                                                Style="{DynamicResource    PrimaryButtonStyle}"
                                                                                Command="{Binding SavePeriodBucketCommand}"
                                                                                Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                        <Button Content="Cancel"
                                                                                Style="{DynamicResource    SecondaryButtonStyle}"
                                                                                Command="{Binding CancelPeriodBucketCommand}"
                                                                                Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Width="80" Margin="2" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <StackPanel Grid.Row="0">
                                                                        <TextBlock
                                                                            Style="{DynamicResource    StyledTextBlock}"
                                                                            Margin="5"
                                                                            TextWrapping="Wrap"
                                                                            Visibility="{Binding IsBucketDescriptionExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                            Current period envelope budgeted amounts, actual spending in those envelopes, and overrides from default estimates. To change estimates, use the envelopes menu on the left to change budget for future spending.
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <DataGrid Grid.Row="1"
                                                                              ItemsSource="{Binding CurrentPeriodBuckets}"
                                                                              SelectedItem="{Binding SelectedPeriodBucket}"
                                                                              AutoGenerateColumns="False"
                                                                              CanUserAddRows="False">
                                                                        <DataGrid.RowStyle>
                                                                            <Style
                                                                                TargetType="{x:Type DataGridRow}"
                                                                                BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsFunded}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#E6F4EA" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding IsSkipped}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#F1F3F4" />
                                                                                        <Setter
                                                                                            Property="Foreground"
                                                                                            Value="#70757A" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding HasActualAmount}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#CCFFCC" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger
                                                                                        Binding="{Binding BudgetExceeded}"
                                                                                        Value="True">
                                                                                        <Setter
                                                                                            Property="Background"
                                                                                            Value="#FFCCCC" />
                                                                                    </DataTrigger>

                                                                                    <!-- Selection Trigger (Overrides Status Colors) -->
                                                                                    <Trigger Property="IsSelected"
                                                                                        Value="True">
                                                                                        <Setter Property="Background"
                                                                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                                                        <Setter Property="Foreground"
                                                                                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                                                                    </Trigger>
                                                                                </Style.Triggers>

                                                                                <!-- 1. Pass MainViewModel to Tag -->
                                                                                <Setter Property="Tag"
                                                                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />

                                                                                <!-- 2. Attach ToolTip -->
                                                                                <Setter Property="ToolTip">
                                                                                    <Setter.Value>
                                                                                        <!-- Background, BorderBrush, BorderThickness, and Padding are handled by the implicit ToolTip style -->
                                                                                        <ToolTip x:Name="BucketToolTip"
                                                                                            helpers1:ToolTipBehavior.OpenCommand="{Binding PlacementTarget.Tag.OnBucketRowHoveredCommand, RelativeSource={RelativeSource Self}}"
                                                                                            helpers1:ToolTipBehavior.OpenCommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                            <StackPanel Width="280">
                                                                                                <!-- Header / Envelope Name -->
                                                                                                <TextBlock
                                                                                                    Text="{Binding BucketName}"
                                                                                                    Style="{StaticResource TooltipHeaderTextBlockStyle}"
                                                                                                    Margin="0,0,0,6" />

                                                                                                <Separator
                                                                                                    Style="{StaticResource TooltipSeparatorStyle}" />

                                                                                                <!-- Analytics Summary Grid inside ToolTip -->
                                                                                                <Grid
                                                                                                    TextBlock.Foreground="{DynamicResource TooltipSecondaryTextBrush}">
                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition
                                                                                                            Width="*" />
                                                                                                        <ColumnDefinition
                                                                                                            Width="Auto" />
                                                                                                    </Grid.ColumnDefinitions>
                                                                                                    <Grid.RowDefinitions>
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                        <RowDefinition
                                                                                                            Height="Auto" />
                                                                                                    </Grid.RowDefinitions>

                                                                                                    <!-- 24-Mo Avg Monthly Spend -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="0"
                                                                                                        Text="24-Mo Avg Monthly:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="0"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AverageSpend, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Avg Monthly Trips / Charges -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Avg Purchases / Month:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AveragePurchasesPerMonth, FallbackValue='0.0', StringFormat='{}{0:0.0} trips'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Avg Per Checkout Trip -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Avg / Purchase:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="2"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AveragePerPurchase, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />

                                                                                                    <!-- Median Per Checkout Trip -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Median / Purchase:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="3"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.MedianPerPurchase, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource GoodNumericHighlightBrush}" />

                                                                                                    <!-- Rec. Monthly Target -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Rec. Target / Mo:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="4"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.SuggestedBudget, FallbackValue='$0.00', StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipHeaderBrush}" />

                                                                                                    <!-- Annual Trend -->
                                                                                                    <TextBlock
                                                                                                        Grid.Row="5"
                                                                                                        Grid.Column="0"
                                                                                                        Text="Annual Inflation:" />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="5"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AnnualizedInflationPercentage, FallbackValue='0.0%', StringFormat='{}{0:+0.0%;-0.0%;0.0%}'}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                </Grid>

                                                                                                <!-- Dynamic Tip with Inlines -->
                                                                                                <TextBlock
                                                                                                    FontSize="10.5"
                                                                                                    Margin="0,8,0,0"
                                                                                                    Foreground="{DynamicResource TooltipSecondaryTextBrush}"
                                                                                                    FontStyle="Italic"
                                                                                                    TextWrapping="Wrap">
                                                                                                    <Run
                                                                                                        Text="Tip: To reduce spending, keep envelope transactions at or below " />
                                                                                                    <Run
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AveragePurchasesPerMonth, Mode=OneWay, StringFormat='{}{0:0.0}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                    <Run
                                                                                                        Text=" / mo while keeping each spend under " />
                                                                                                    <Run
                                                                                                        Text="{Binding RelativeSource={RelativeSource AncestorType=ToolTip}, Path=PlacementTarget.Tag.HoveredBucketMetrics.AveragePerPurchase, Mode=OneWay, StringFormat='{}{0:C}'}"
                                                                                                        FontWeight="Bold"
                                                                                                        Foreground="{DynamicResource TooltipTextBrush}" />
                                                                                                    <Run Text="." />
                                                                                                </TextBlock>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </DataGrid.RowStyle>
                                                                        <DataGrid.InputBindings>
                                                                            <MouseBinding
                                                                                MouseAction="LeftDoubleClick"
                                                                                Command="{Binding EditPeriodBucketCommand}" />
                                                                        </DataGrid.InputBindings>
                                                                        <DataGrid.Columns>
                                                                            <DataGridTemplateColumn
                                                                                Header="Envelope"
                                                                                Width="*">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel
                                                                                            Orientation="Horizontal"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="4,0">
                                                                                            <TextBlock
                                                                                                Text="{Binding BucketName}"
                                                                                                FontWeight="SemiBold" />
                                                                                            <Border
                                                                                                Margin="8,0,0,0"
                                                                                                Padding="4,1"
                                                                                                CornerRadius="3"
                                                                                                Visibility="{Binding IsAccumulatingDrawdown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                                <Border.Style>
                                                                                                    <Style
                                                                                                        TargetType="Border">
                                                                                                        <Setter
                                                                                                            Property="Background"
                                                                                                            Value="#E8EAED" />
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsFunded}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#CEEAD6" />
                                                                                                            </DataTrigger>
                                                                                                            <DataTrigger
                                                                                                                Binding="{Binding IsSkipped}"
                                                                                                                Value="True">
                                                                                                                <Setter
                                                                                                                    Property="Background"
                                                                                                                    Value="#F1F3F4" />
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Border.Style>
                                                                                                <TextBlock
                                                                                                    Text="{Binding FundingStatus}"
                                                                                                    FontSize="10"
                                                                                                    FontWeight="Bold"
                                                                                                    Foreground="#3C4043" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>

                                                                            <DataGridTextColumn
                                                                                Header="Target / Set Aside"
                                                                                Binding="{Binding ActualAmount, StringFormat=C}"
                                                                                Width="140">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>

                                                                            <DataGridTextColumn Header="Spent"
                                                                                    Binding="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                                                    IsReadOnly="True" Width="120">
                                                                                <DataGridTextColumn.ElementStyle>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter
                                                                                            Property="TextAlignment"
                                                                                            Value="Right" />
                                                                                        <Setter Property="Padding"
                                                                                            Value="0,0,8,0" />
                                                                                    </Style>
                                                                                </DataGridTextColumn.ElementStyle>
                                                                            </DataGridTextColumn>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>

                                                                    <StackPanel
                                                                        Grid.Row="2"
                                                                        Margin="10"
                                                                        Visibility="{Binding IsEditingPeriodBucket, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            FontWeight="Bold"
                                                                            Margin="0,0,0,5">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text"
                                                                                        Value="Edit Period Budget" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger
                                                                                            Binding="{Binding EditingPeriodBucketClone.IsAccumulatingDrawdown}"
                                                                                            Value="True">
                                                                                            <Setter Property="Text"
                                                                                                Value="Edit Envelope Set Aside Funding" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Label
                                                                                Style="{DynamicResource    StyledLabel}"
                                                                                Grid.Column="0"
                                                                                Content="Name:" />
                                                                            <TextBox Grid.Column="1"
                                                                                    Text="{Binding EditingPeriodBucketClone.BucketName, UpdateSourceTrigger=PropertyChanged}"
                                                                                    IsEnabled="False"
                                                                                    Margin="5" />
                                                                            <Label Grid.Column="2">
                                                                                <Label.Style>
                                                                                    <Style TargetType="Label"
                                                                                        BasedOn="{StaticResource StyledLabel}">
                                                                                        <Setter Property="Content"
                                                                                            Value="Budgeted:" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger
                                                                                                Binding="{Binding EditingPeriodBucketClone.IsAccumulatingDrawdown}"
                                                                                                Value="True">
                                                                                                <Setter
                                                                                                    Property="Content"
                                                                                                    Value="Set Aside Amount:" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Label.Style>
                                                                            </Label>
                                                                            <controls:NumericTextBox
                                                                                Grid.Column="3"
                                                                                Text="{Binding EditingPeriodBucketClone.ActualAmount, UpdateSourceTrigger=PropertyChanged}"
                                                                                Margin="5" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DockPanel>
                                                        </TabItem>
                                                    </TabControl>
                                                </DockPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- Index 2: Accounts View -->
                                    <DataTrigger Binding="{Binding SelectedOuterTabIndex}" Value="1">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Bottom">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                            <Button Content="Delete"
                                                                    Command="{Binding DeleteSelectedAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Style>
                                                                    <Style TargetType="Button"
                                                                           BasedOn="{StaticResource DangerButtonStyle}">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger
                                                                                Binding="{Binding EditingAccountClone.Id, Converter={StaticResource IntToVisibilityConverter}}"
                                                                                Value="Collapsed">
                                                                                <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <!-- <DataTrigger -->
                                                                            <!--     Binding="{Binding IsEditingAccount}" -->
                                                                            <!--     Value="False"> -->
                                                                            <!--     <Setter Property="Visibility" -->
                                                                            <!--         Value="Collapsed" /> -->
                                                                            <!-- </DataTrigger> -->
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="Reconcile"
                                                                    Style="{DynamicResource    SecondaryButtonStyle}"
                                                                    Command="{Binding ReconcileAccountCommand}"
                                                                    Width="80"
                                                                    Margin="2">
                                                                <Button.Visibility>
                                                                    <MultiBinding
                                                                        Converter="{StaticResource BooleanAndToVisibilityConverter}">

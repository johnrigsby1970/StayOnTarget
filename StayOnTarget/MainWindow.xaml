                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">

                                <!-- SECTION 1: BUSTED BUCKETS & OVERSPEND (Collapses if empty) -->
                                <ItemsControl ItemsSource="{Binding BudgetBustedBuckets}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderColorBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,6"
                                                Padding="8,6">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding DataContext.MapsToBucketCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <DockPanel>
                                                    <TextBlock
                                                        Text="{Binding TransactionAmount, Converter={StaticResource AbsoluteValueConverter}, StringFormat=C}"
                                                        DockPanel.Dock="Right"
                                                        FontWeight="SemiBold"
                                                        FontSize="11"
                                                        VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BudgetExceeded}"
                                                                            Value="true">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                               Text="{Binding BucketName}"
                                                               FontWeight="Medium"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </ScrollViewer>
                            <!-- SECTION 2: UPCOMING 30-DAY STRATEGY SWEEPS & SNOWBALL TASKS -->
                            <Border
                                Margin="0,4,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Default state: Collapsed -->
                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>
                                            <!-- Show ONLY when EnableSnowball is True AND Count produces 'Visible' -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SnowballOptions.EnableSnowball}"
                                                               Value="True" />
                                                    <Condition
                                                        Binding="{Binding UpcomingStrategyTasks.Count, Converter={StaticResource IntToVisibilityConverter}}"
                                                        Value="Visible" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>

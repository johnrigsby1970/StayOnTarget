                                    <Border Background="{DynamicResource UpcomingBillPillBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            ToolTip="Upcoming Bills (Next 7 Days)"
                                            Visibility="{Binding UpcomingCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Calendar / Clock Icon -->
                                            <Path
                                                Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                                Fill="{DynamicResource WarningBrush}"
                                                Width="12" Height="12"
                                                Stretch="Uniform"
                                                Margin="0,0,4,0" />
                                            <TextBlock
                                                Text="{Binding UpcomingCount, StringFormat='{}Upcoming ({0})'}"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource WarningBrush}"
                                                VerticalAlignment="Center" />

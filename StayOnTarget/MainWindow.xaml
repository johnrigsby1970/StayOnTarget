                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" />

            <!-- Right Panel: Projections -->
            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                <Label Style="{DynamicResource    StyledLabel}" DockPanel.Dock="Top"
                       Content="{Binding YearsProjecting, Converter={StaticResource ProjectionYearsLabelConverter}}"
                       Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1" CornerRadius="4"
                            Padding="6,4" Margin="0,4,0,8" Grid.Row="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Label Style="{DynamicResource    StyledLabel}" Content="Start:"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0" />
                                <DatePicker
                                    SelectedDate="{Binding ProjectionStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                    VerticalAlignment="Center" Margin="5,0,0,0" />
                                <Label Style="{DynamicResource    StyledLabel}" Content="End:"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                <DatePicker DisplayDateStart="{x:Static System:DateTime.Today}"
                                            SelectedDate="{Binding ProjectionEndDate}" VerticalAlignment="Center"
                                            Margin="5,0,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Command="{Binding SetOneYearCommand}" Content="1 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" />
                                <Button Command="{Binding SetFiveYearCommand}" Content="5 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetTenYearCommand}" Content="10 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                                <Button Command="{Binding SetThirtyYearCommand}" Content="30 yr" Padding="10,4"
                                        Style="{DynamicResource    SecondaryButtonStyle}" Margin="-1,0,0,0" />
                            </StackPanel>

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Content="Pay off new credit card spending each period"
                                      Foreground="{DynamicResource SecondaryTextBrush}"
                                      IsChecked="{Binding UseAutoSweep}" VerticalAlignment="Center"
                                      Margin="5,6,5,2" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <TabControl
                            Style="{DynamicResource    InnerTabControlStyle}"
                            ItemContainerStyle="{DynamicResource    ModernUnderlineTabItemStyle}"
                            SelectedIndex="{Binding SelectedProjectionTabIndex}">
                            <TabItem Header="Current Plan">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" />
                                    </Grid.RowDefinitions>

                                    <DataGrid x:Name="ProjectionGrid" Grid.Row="0"
                                              ItemsSource="{Binding Projections}"
                                              helpers1:DynamicAccountColumnsBehavior.Accounts="{Binding VisibleAccounts}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              EnableRowVirtualization="True"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.RowStyle>

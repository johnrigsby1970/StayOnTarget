                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Style="{DynamicResource StyledTextBlock}"
                                           Text="Alerts &amp; Action Items"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center"

                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource    SpecialHeadingBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                   Text="Next 31 Days"
                                                   FontSize="10"
                                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding UpcomingStrategyTasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Background="{DynamicResource    StrategyTaskBackgroundBrush}"
                                                        BorderBrush="{DynamicResource    StrategyTaskBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontWeight="SemiBold" FontSize="11"
                                                                           Foreground="{DynamicResource    StrategyTaskTitleBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Foreground="{DynamicResource    StrategyTaskTextBrush}"
                                                                    Text="{Binding DueDate, StringFormat='Target: {0:MM/dd/yyyy}'}"
                                                                    FontSize="10" />
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding Amount, StringFormat=C}"
                                                                       Grid.Column="1"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource    StrategyTaskBrush}"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>


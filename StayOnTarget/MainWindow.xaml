                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right">

                                    <!-- Past Due Bills Pill (Only visible if PastDueCount > 0) -->
                                    <Border Background="{DynamicResource PastDuePillBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            Margin="0,0,6,0"
                                            ToolTip="Past Due Bills"
                                            Visibility="{Binding PastDueCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Exclamation / Warning Icon -->
                                            <Path
                                                Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"

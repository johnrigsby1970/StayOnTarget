                                                                                FontSize="10.5"
                                                                                TextWrapping="Wrap"
                                                                                LineHeight="15"
                                                                                Opacity="0.85" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                </StackPanel>

                                                                <Grid Margin="0,2,0,0">
                                                                    <Grid.ColumnDefinitions>

                                    <Border x:Name="OptionsPanelBorder"
                                            Panel.ZIndex="100"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Stretch"
                                            Width="425" Margin="0" Padding="16,12"
                                            Background="{DynamicResource SidebarBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                            BorderThickness="1,0,0,0"
                                            Visibility="{Binding ElementName=OptionsTabBtn, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.25"
                                                              Color="Black" />
                                        </Border.Effect>

                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="FlyoutTransform" X="0" />
                                            <!-- Hidden off-screen right by default -->
                                        </Border.RenderTransform>

                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!-- Slide in when IsFlyoutOpen is True -->
                                                    <DataTrigger Binding="{Binding IsFlyoutOpen}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                        To="0" Duration="0:0:0.1">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation
                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                        To="425" Duration="0:0:0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <!-- Pull-out Toggle Button protruding from the left border -->
                                            <Button Command="{Binding ToggleFlyoutCommand}"
                                                    Width="22" Height="42"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="-38,0,0,0">
                                                <!-- <Path Data="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z" -->
                                                <!--       Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" -->
                                                <!--       Width="8" /> -->
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4,0,0,4" SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Content" Value="◀" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFlyoutOpen}" Value="True">
                                                                <Setter Property="Content" Value="▶" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource ButtonSecondaryHoverBackgroundBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>

                                            </Button>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                                <StackPanel>

                                                    <!-- HEADER & MAIN TOGGLE -->
                                                    <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                                        <TextBlock Text="Snowball Strategy Options"
                                                                   Style="{DynamicResource StyledTextBlock}"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   DockPanel.Dock="Left"
                                                                   VerticalAlignment="Center" />
                                                        <CheckBox Content="Enable Snowball Strategy"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}"
                                                                  IsChecked="{Binding SnowballOptions.EnableSnowball}"
                                                                  DockPanel.Dock="Right"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center"
                                                                  FontSize="12.5"
                                                                  FontWeight="SemiBold" />
                                                    </DockPanel>

                                                    <Separator Margin="0,0,0,12"
                                                               Background="{DynamicResource SeparatorBrush}" />

                                                    <!-- SECTION 1: CORE STRATEGY SELECTIONS (2 COLUMNS) -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Primary Target -->
                                                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
                                                            <TextBlock Text="Primary Allocation Target"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <ComboBox Style="{DynamicResource StyledEnumComboBox}"
                                                                      ItemsSource="{Binding Source={StaticResource EnumSurplusAllocationTarget}}"
                                                                      SelectedItem="{Binding SnowballOptions.PrimaryTarget}" />
                                                        </StackPanel>

                                                        <!-- Debt Strategy -->
                                                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,10">
                                                            <TextBlock Text="Debt Payoff Strategy"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <ComboBox Style="{DynamicResource StyledEnumComboBox}"
                                                                      ItemsSource="{Binding Source={StaticResource EnumSnowballSortStrategy}}"
                                                                      SelectedItem="{Binding SnowballOptions.DebtSortStrategy}" />
                                                        </StackPanel>

                                                        <!-- Investment Strategy -->
                                                        <StackPanel Grid.Column="0" Grid.Row="1">
                                                            <TextBlock Text="Investment Strategy"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <ComboBox Style="{DynamicResource StyledEnumComboBox}"
                                                                      ItemsSource="{Binding Source={StaticResource EnumInvestmentStrategy}}"
                                                                      SelectedItem="{Binding SnowballOptions.InvestmentStrategy}" />
                                                        </StackPanel>

                                                        <!-- Surplus Method -->
                                                        <StackPanel Grid.Column="2" Grid.Row="1">
                                                            <TextBlock Text="Surplus Calculation Method"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <ComboBox Style="{DynamicResource StyledEnumComboBox}"
                                                                      ItemsSource="{Binding Source={StaticResource EnumSurplusCalculationMethod}}"
                                                                      SelectedItem="{Binding SnowballOptions.SurplusMethod}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Fixed Monthly Surplus (Appears conditionally) -->
                                                    <StackPanel Margin="0,0,0,10"
                                                                Visibility="{Binding SnowballOptions.SurplusMethod, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=FixedMonthlyAmount}">
                                                        <TextBlock Text="Fixed Monthly Surplus Commitment ($)"
                                                                   Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                   FontWeight="SemiBold" FontSize="11"
                                                                   Margin="0,0,0,4" />
                                                        <TextBox
                                                            Text="{Binding SnowballOptions.FixedMonthlySurplusAmount, StringFormat=C0, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <Separator Margin="0,4,0,12"
                                                               Background="{DynamicResource SeparatorBrush}" />

                                                    <!-- SECTION 2: BUFFERS & LIMITS (2 COLUMNS) -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left: Safety Floor & Roth Limits -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Checking Minimum Safety Floor ($)"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox
                                                                Text="{Binding SnowballOptions.CheckingSafetyBufferAmount, StringFormat=C0, UpdateSourceTrigger=PropertyChanged}"
                                                                Margin="0,0,0,10" />

                                                            <TextBlock Text="Annual Roth IRA Limit ($)"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <TextBox
                                                                Text="{Binding SnowballOptions.AnnualRothIraContributionLimit, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <!-- Right: Excluded Accounts Button -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                            <TextBlock Text="Account Management"
                                                                       Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                       FontWeight="SemiBold" FontSize="11"
                                                                       Margin="0,0,0,4" />
                                                            <Button Content="Manage Excluded Debts / Accounts"
                                                                    Command="{Binding OpenManageExcludedAccountsCommand}"
                                                                    Padding="8,6"
                                                                    Style="{DynamicResource SecondaryButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Separator Margin="0,4,0,12"
                                                               Background="{DynamicResource SeparatorBrush}" />

                                                    <!-- SECTION 3: SLIDERS & PERCENTAGES (2 COLUMNS) -->
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="12" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Checking Cushion Slider -->
                                                        <StackPanel Grid.Column="0">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock Text="Checking Cushion %: "
                                                                           Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                           FontWeight="SemiBold" FontSize="11" />
                                                                <TextBlock
                                                                    Text="{Binding SnowballOptions.CheckingSafetyThresholdPct, StringFormat={}{0:P0}}"
                                                                    FontWeight="Bold" Foreground="#3B82F6"
                                                                    FontSize="11"
                                                                    HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                                                    IsSnapToTickEnabled="True"
                                                                    Value="{Binding SnowballOptions.CheckingSafetyThresholdPct, Converter={StaticResource DoubleToDecimalConverter}, Delay=300}"
                                                                    Margin="0,0,0,4" />
                                                            <TextBlock
                                                                Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                TextWrapping="Wrap"
                                                                Text="Minimum buffer kept in Checking. Excess is sweepable."
                                                                FontSize="10" LineHeight="13" />
                                                        </StackPanel>

                                                        <!-- Goal Contribution Slider -->
                                                        <StackPanel Grid.Column="2">
                                                            <DockPanel Margin="0,0,0,4">
                                                                <TextBlock
                                                                    Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                    Text="Goal Contribution Rate: "
                                                                    FontWeight="SemiBold" FontSize="11" />
                                                                <TextBlock
                                                                    Text="{Binding SnowballOptions.SurplusSweepPercentage, StringFormat={}{0:P0}}"
                                                                    FontWeight="Bold" Foreground="#3B82F6"
                                                                    FontSize="11"
                                                                    HorizontalAlignment="Right" />
                                                            </DockPanel>
                                                            <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                                                                    IsSnapToTickEnabled="True"
                                                                    Value="{Binding SnowballOptions.SurplusSweepPercentage, Converter={StaticResource DoubleToDecimalConverter}, Delay=300}"
                                                                    Margin="0,0,0,4" />
                                                            <TextBlock
                                                                Style="{DynamicResource StyledSecondaryTextBlock}"
                                                                TextWrapping="Wrap"
                                                                Text="Percentage of extra cash moved to debt/investments."
                                                                FontSize="10" LineHeight="13" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- STRATEGY COMPARISON CARD -->
                                                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderColorBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,10"
                                                            Margin="0,0,0,10"
                                                            Visibility="{Binding ShowSnowballAnalysis, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <TextBlock Text="Strategy Comparison"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource StrategyComparisonTextBrush}"
                                                                       Margin="0,0,0,8" />

                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Estimated Debt Free / End Debt -->
                                                                <StackPanel Grid.Column="0">
                                                                    <StackPanel
                                                                        Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}}">
                                                                        <TextBlock
                                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                                            FontSize="11.5">
                                                                            <Run Text="Estimated Debt Free: " />
                                                                            <Run
                                                                                Text="{Binding SnowballDebtFreeDate, StringFormat={}{0:MMM yyyy}, Mode=OneWay}"
                                                                                FontWeight="Bold" />
                                                                        </TextBlock>
                                                                        <TextBlock
                                                                            Foreground="{Binding SnowballMonthsSaved, Converter={StaticResource DeltaToBrushConverter}}"
                                                                            FontSize="10.5" FontWeight="Bold"
                                                                            Margin="0,1,0,0"
                                                                            Visibility="{Binding SnowballMonthsSaved, Converter={StaticResource IntToVisibilityConverter}}">
                                                                            <Run Text="(Saves " />
                                                                            <Run
                                                                                Text="{Binding SnowballMonthsSaved, Mode=OneWay}" />
                                                                            <Run Text=" mos vs current)" />
                                                                        </TextBlock>
                                                                    </StackPanel>

                                                                    <StackPanel
                                                                        Visibility="{Binding SnowballDebtFreeDate, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                                                        <TextBlock
                                                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                                                            FontSize="11.5">
                                                                            <Run Text="End Projection Debt: " />
                                                                            <Run
                                                                                Text="{Binding SnowballFinalDebt, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}"
                                                                                FontWeight="Bold" />
                                                                        </TextBlock>
                                                                        <TextBlock
                                                                            Foreground="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource DeltaToBrushConverter}}"
                                                                            FontSize="10.5" FontWeight="Bold"
                                                                            Margin="0,1,0,0"
                                                                            Visibility="{Binding SnowballDebtReductionVsStandard, Converter={StaticResource IntToVisibilityConverter}}">
                                                                            <Run Text="(" />
                                                                            <Run
                                                                                Text="{Binding SnowballDebtReductionVsStandard, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
                                                                            <Run Text=" vs current)" />
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Final Net Worth -->
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        FontSize="11.5">
                                                                        <Run Text="Final Net Worth: " />
                                                                        <Run
                                                                            Text="{Binding SnowballFinalNetWorth, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}"
                                                                            FontWeight="Bold" />
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Foreground="{Binding SnowballNetWorthImprovement, Converter={StaticResource DeltaToBrushConverter}}"
                                                                        FontSize="10.5" FontWeight="Bold"
                                                                        Margin="0,1,0,0">
                                                                        <Run Text="(" />
                                                                        <Run
                                                                            Text="{Binding SnowballNetWorthImprovement, StringFormat='{}{0:+$#,##0;-$#,##0;$0}', Mode=OneWay}" />
                                                                        <Run Text=" improvement)" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Border BorderBrush="#BAE6FD" BorderThickness="0,1,0,0"
                                                                    Margin="0,6,0,0" Padding="0,6,0,0">
                                                                <StackPanel>
                                                                    <TextBlock
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        TextWrapping="Wrap" FontSize="11"
                                                                        FontWeight="SemiBold" LineHeight="15"
                                                                        Margin="0,0,0,4">
                                                                        <Run Text="💡 " />
                                                                        <Run
                                                                            Text="{Binding StrategyTakeawayPrimary, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                    <TextBlock
                                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                                        TextWrapping="Wrap" FontSize="10.5"
                                                                        LineHeight="14" FontStyle="Italic">
                                                                        <Run
                                                                            Text="{Binding StrategyTakeawayDilemma, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock
                                                        Text="Tip: Settings are applied instantly automatically."
                                                        FontSize="10.5"
                                                        Foreground="{DynamicResource PrimaryAccentBrush}"
                                                        FontStyle="Italic"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>


                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- 2. Overlay Legend floating in the top-right aligned with the Tab Header strip -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,4,12,0"
                                    Panel.ZIndex="10">

                            <!-- Money In (Green Diamond) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle Width="7" Height="7"
                                           Fill="{DynamicResource PositiveBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0">
                                    <Rectangle.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="3.5" CenterY="3.5" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                                <TextBlock Text="Money In"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Money Out (Red Square) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Rectangle Width="8" Height="8"
                                           Fill="{DynamicResource NegativeBrush}"
                                           RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Center"
                                           Margin="4,0,4,0" />
                                <TextBlock Text="Money Out"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>


                        </StackPanel>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- OVERLAY MODAL: Manage Excluded Debts & Accounts -->
        <Grid
            Visibility="{Binding IsManageExclusionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
            Grid.Row="0" Grid.Column="0" Grid.RowSpan="99" Grid.ColumnSpan="99" Panel.ZIndex="1000">

            <Border Background="#80000000" MouseDown="CloseOverlayOnBackdropClick" />

            <Border Width="420" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ModalBackgroundBrush}" CornerRadius="8" Padding="20"
                    BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="Black" />
                </Border.Effect>

                <Grid RowDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Style="{DynamicResource    StyledTextBlock}" Text="Manage Excluded Accounts"
                                   FontSize="18" FontWeight="Bold" />
                        <TextBlock Style="{DynamicResource    StyledSecondaryTextBlock}"
                                   Text="Checked accounts will be skipped by the Snowball/Avalanche engine during surplus sweeps."
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <ItemsControl ItemsSource="{Binding ExcludableAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceBackgroundBrush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource BorderColorBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      IsChecked="{Binding IsExcludedInSnowball, Mode=TwoWay}"
                                                      Command="{Binding DataContext.ToggleAccountExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding Id}" />

                                            <Border DockPanel.Dock="Right" Background="#E2E8F0" CornerRadius="4"
                                                    Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock
                                                    Style="{DynamicResource    StyledTextBlock}"
                                                    Text="{Binding Type}"
                                                    FontSize="10"
                                                    FontWeight="SemiBold" />
                                            </Border>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{DynamicResource    StyledTextBlock}"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Style="{DynamicResource    StyledSecondaryTextBlock}"
                                                           FontSize="11">
                                                    <Run Text="Balance: " />
                                                    <Run Text="{Binding Balance, StringFormat=C0}"
                                                         FontWeight="Bold" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Done"
                                Command="{Binding CloseManageExcludedAccountsCommand}"
                                Style="{DynamicResource    PrimaryButtonStyle}"
                                Width="90"
                                Height="32" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Accounts Overlay -->
        <userControls:EditAccountsUserControl Grid.Row="0" Grid.RowSpan="3"
                                              Panel.ZIndex="2000"
                                              Visibility="{Binding IsEditingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Bills Overlay -->
        <userControls:EditBillsUserControl Grid.Row="0" Grid.RowSpan="3"
                                           Panel.ZIndex="2000"
                                           Visibility="{Binding IsEditingBill, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- Buckets Overlay -->
        <userControls:EditBucketsUserControl Grid.Row="0" Grid.RowSpan="3"
                                             Panel.ZIndex="2000"
                                             Visibility="{Binding IsEditingBucket, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <!-- Categories Overlay -->
        <userControls:EditCategoriesUserControl Grid.Row="0" Grid.RowSpan="3"
                                                Panel.ZIndex="2000"
                                                Visibility="{Binding IsEditingCategory, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Paychecks Overlay -->
        <userControls:EditPaychecksUserControl Grid.Row="0" Grid.RowSpan="3"
                                               Panel.ZIndex="2000"
                                               Visibility="{Binding IsEditingPaycheck, Converter={StaticResource BooleanToVisibilityConverter}}" />


        <!-- Transactions Overlay -->
        <userControls:EditTransactionsUserControl Grid.Row="0" Grid.RowSpan="3"
                                                  Panel.ZIndex="2000"
                                                  Visibility="{Binding IsEditingTransaction, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>

</Window>